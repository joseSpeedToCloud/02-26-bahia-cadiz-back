# Copiar a .env (gitignored) y ajustar para desarrollo local.
# En produccion estas variables las inyecta Secret Manager / Terraform (TASK-008), nunca un .env en el repo.

DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal
DRUPAL_DB_PASSWORD=drupal
DRUPAL_DB_ROOT_PASSWORD=root
DRUPAL_DB_HOST=db
DRUPAL_DB_PORT=3306

# Generar uno propio por entorno, p.ej.: openssl rand -hex 32
DRUPAL_HASH_SALT=CHANGE-ME-INSECURE-DEV-ONLY-SALT-DO-NOT-USE-IN-PROD
